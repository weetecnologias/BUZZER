# BUZZER environment variables. Copy to .env (never commit real values).
# In staging/production, inject these from a secrets manager (AWS Secrets Manager / GCP Secret Manager / Vault).

# --- Backend ---
BUZZER_DB_URL=jdbc:postgresql://localhost:5432/buzzer
BUZZER_DB_USER=buzzer
BUZZER_DB_PASSWORD=change-me
BUZZER_DB_POOL_SIZE=20
# >= 32 random bytes, e.g. `openssl rand -base64 48`
BUZZER_JWT_SECRET=
BUZZER_OTP_PEPPER=
BUZZER_ACCESS_TOKEN_MINUTES=30
BUZZER_REFRESH_TOKEN_DAYS=30
# mock = TEST MODE gateway. Real gateways need an adapter + merchant credentials.
BUZZER_PAYMENT_PROVIDER=mock
BUZZER_PAYMENT_WEBHOOK_SECRET=
# log = TEST MODE SMS adapter (logs redacted messages). Replace with a real provider adapter.
BUZZER_SMS_PROVIDER=log
BUZZER_SUPPORT_PHONE=+914000000000
BUZZER_CORS_ORIGINS=https://admin.buzzer.example,https://agent.buzzer.example
BUZZER_HEALTH_CUSTOMER_URL=
BUZZER_HEALTH_PARTNER_URL=
BUZZER_HEALTH_AGENT_URL=
BUZZER_HEALTH_ADMIN_URL=

# --- Admin web (Next.js BFF) ---
BUZZER_BACKEND_URL=http://localhost:8080

# --- Mobile apps (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:8080
